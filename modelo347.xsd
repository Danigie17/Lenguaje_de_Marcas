<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
<!--Tipos Simples-->
<xsd:simpleType name="tipoTipo">
    <xsd:restriction base="xsd:string">
        <xsd:enumeration value="sociedad limitada"/>
        <xsd:enumeration value="sociedad anónima"/>
        <xsd:enumeration value="comunidad de bienes"/>
        <xsd:enumeration value="autónomo"/>
    </xsd:restriction>
</xsd:simpleType>
<xsd:simpleType name="tipoDocumento">
    <xsd:restriction base="xsd:string">
        <xsd:enumeration value="nif"/>
        <xsd:enumeration value="cif"/>
    </xsd:restriction>
</xsd:simpleType>
<xsd:simpleType name="tipoVia">
    <xsd:restriction base="xsd:string">
        <xsd:enumeration value="calle"/>
        <xsd:enumeration value="avenida"/>
        <xsd:enumeration value="paseo"/>
        <xsd:enumeration value="otro"/>
    </xsd:restriction>
</xsd:simpleType>
<!--Tipos Complejos-->
<xsd:complexType name="tipoDireccion">
    <xsd:sequence>
        <xsd:element name="via" type="tipoVia"/>
        <xsd:element name="nombreVia" type="xsd:string"/>
        <xsd:element name="numero" type="xsd:integer"/>
        <xsd:element name="municipio" type="tipoMunicipio"/>
        <xsd:element name="provincia" type="xsd:string"/>
    </xsd:sequence>
</xsd:complexType>
<xsd:complexType name="tipoIdentificacion">
    <xsd:attribute name="documento" type="tipoDocumento" use="required"/>
    <xsd:attribute name="id" type="xsd:string" use="required"/>
</xsd:complexType>
<xsd:complexType name="tipoNombreFiscal">
    <xsd:simpleContent>
        <xsd:extension base="xsd:string">
            <xsd:attribute name="tipo" type="tipoTipo"/>
        </xsd:extension>
    </xsd:simpleContent>
</xsd:complexType>
<xsd:complexType name="tipoProveedorCliente">
    <xsd:sequence>
        <xsd:element name="nombreFiscal" type="tipoNombreFiscal"/>
        <xsd:element name="identificacion" type="tipoIdentificacion"/>
        <xsd:element name="direccion" type="tipoDireccion" maxOccurs="3"/>
        <xsd:element name="datosContables" type="tipoDatosContables"/>
    </xsd:sequence>
</xsd:complexType>
<xsd:complexType name="tipoModelo347">
    <xsd:sequence>
        <xsd:element name="proveedor" type="tipoProveedorCliente" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element name="cliente" type="tipoProveedorCliente" minOccurs="0" maxOccurs="unbounded"/>
    </xsd:sequence>
</xsd:complexType>
<!--Elemento Raíz-->
<xsd:element name="modelo347" type="tipoModelo347"/>
</xsd:schema>