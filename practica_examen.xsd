<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

<xsd:simpleType name="tipoCodigoCurso">
    <xsd:restriction base="xsd:string">
        <xsd:pattern value="CUR-[0-9]{3}"/>
    </xsd:restriction>
</xsd:simpleType>

<xsd:simpleType name="tipoModalidad">
    <xsd:restriction base="xsd:string">
        <xsd:enumeration value="presencial"/>
        <xsd:enumeration value="online"/>
    </xsd:restriction>
</xsd:simpleType>

<xsd:complexType name="tipoProfesor">
    <xsd:simpleContent>
        <xsd:extension base="xsd:string">
            <xsd:attribute name="experiencia" type="xsd:integer" use="required"/>
        </xsd:extension>
    </xsd:simpleContent>
</xsd:complexType>

<xsd:complexType name="tipoAlumno">
    <xsd:sequence>
        <xsd:element name="nombre" type="xsd:string"/>
        
        <xsd:choice>
            <xsd:element name="telefono" type="xsd:string"/>
            <xsd:element name="email" type="xsd:string"/>
        </xsd:choice>

    </xsd:sequence>

    <xsd:attribute name="matricula" type="xsd:string" use="required"/>
</xsd:complexType>

<xsd:complexType name="tipoAlumnos">
    <xsd:sequence>
        <xsd:element name="alumno" type="tipoAlumno" minOccurs="1" maxOccurs="unbounded"/>
    </xsd:sequence>
</xsd:complexType>

<xsd:complexType name="tipoCurso">
    <xsd:sequence>
        <xsd:element name="titulo" type="xsd:string"/>
        <xsd:element name="profesor" type="tipoProfesor"/>
        <xsd:element name="alumnos" type="tipoAlumnos"/>
    </xsd:sequence>

    <xsd:attribute name="codigo" type="tipoCodigoCurso" use="required"/>
    <xsd:attribute name="modalidad" type="tipoModalidad" use="required"/>
    <xsd:attribute name="creditos" type="xsd:integer" use="optional"/>

</xsd:complexType>

<xsd:complexType name="tipoAcademia">
    <xsd:sequence>
        <xsd:element name="curso" type="tipoCurso" minOccurs="1" maxOccurs="3"/>
    </xsd:sequence>
</xsd:complexType>

<xsd:element name="academia" type="tipoAcademia"/>

</xsd:schema>