<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

<xsd:simpleType name="tipoGenero">
    <xsd:restriction base="xsd:string">
        <xsd:enumeration value="accion"/>
        <xsd:enumeration value="drama"/>
        <xsd:enumeration value="comedia"/>
        <xsd:enumeration value="ciencia_ficcion"/>
    </xsd:restriction>
</xsd:simpleType>

<xsd:complexType name="tipoActor">
    <xsd:simpleContent>
        <xsd:extension base="xsd:string">
            <xsd:attribute name="edad" type="xsd:integer" use="required"/>
        </xsd:extension>
    </xsd:simpleContent>
</xsd:complexType>

<xsd:complexType name="tipoReparto">
    <xsd:sequence>
        <xsd:element name="actor" type="tipoActor" maxOccurs="unbounded"/>
    </xsd:sequence>
</xsd:complexType>

<xsd:complexType name="tipoPelicula">
    <xsd:sequence>
        <xsd:element name="titulo" type="xsd:string"/>
        <xsd:element name="director" type="xsd:string"/>
        <xsd:element name="anio" type="xsd:integer"/>
        <xsd:element name="genero" type="tipoGenero"/>
        <xsd:element name="reparto" type="tipoReparto"/>
    </xsd:sequence>
    <xsd:attribute name="id" type="xsd:string" use="required"/>
</xsd:complexType>

<xsd:complexType name="tipoCatalogo">
    <xsd:sequence>
        <xsd:element name="pelicula" type="tipoPelicula" maxOccurs="unbounded"/>
    </xsd:sequence>
</xsd:complexType>

<xsd:element name="catalogo" type="tipoCatalogo"/>

</xsd:schema>